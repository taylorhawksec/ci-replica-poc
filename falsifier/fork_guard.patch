--- .github/workflows/test-workflow.yml	2026-10-07 08:10:54.909267400 -0500
+++ falsifier/test-workflow.yml	2026-10-07 08:11:15.003588300 -0500
@@ -15,6 +15,18 @@
       checks: write
       packages: write
     steps:
+      # FIX: issue_comment never populates github.event.pull_request, so the head repo
+      # must be resolved at runtime; note the secret step below is `if: always()`, so a
+      # failing step alone would NOT protect it — the step must be gated explicitly.
+      - name: Reject fork PRs
+        if: ${{ inputs.is_pr_comment }}
+        id: forkcheck
+        env: { GH_TOKEN: "${{ secrets.GITHUB_TOKEN }}" }
+        run: |
+          fork=$(gh api "repos/$GITHUB_REPOSITORY/pulls/${{ inputs.pr_number }}" --jq .head.repo.fork)
+          echo "fork=$fork" >> "$GITHUB_OUTPUT"
+          echo "PR head repo is fork=$fork"
+
       # same as upstream:62/128/244 — the PR HEAD, not the base
       - uses: actions/checkout@v3
         with:
@@ -25,7 +37,7 @@
 
